# ID da mesma aplicação Discord utilizada pela Minako (público)
VITE_DISCORD_CLIENT_ID=COLOQUE_O_CLIENT_ID
DISCORD_CLIENT_ID=COLOQUE_O_CLIENT_ID

# OAuth2 Client Secret da aplicação Discord. NUNCA coloque este valor em VITE_*
DISCORD_CLIENT_SECRET=COLOQUE_O_CLIENT_SECRET

# Copie o mesmo DATABASE_URL usado pela Minako. Mantenha-o privado.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Porta do backend local
PORT=3001
